# SPD Ready — environment variables
# Copy to .env.local and fill in real values. NEVER commit .env.local.

# Supabase project (client-safe — exposed to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only secret — used by scripts/seed-*.mjs and server-side admin tasks.
# This is a service_role key: it bypasses RLS. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional alias some scripts read instead of NEXT_PUBLIC_SUPABASE_URL
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
